# Copy to .env and fill in your own settings. Never commit .env.
# Values are literal: no variable expansion or inline comments.
# Single/double quotes may surround a value. Use forward slashes in paths.

# Included only in your local debug APK; release defaults stay empty.
IPTV_SERVER_URL=https://provider.example:8080/
IPTV_USERNAME=
IPTV_PASSWORD=
# Optional comma-separated retired base addresses to replace in saved settings.
IPTV_LEGACY_SERVER_URLS=

# Deployment destination (not included in the APK).
FIRESTICK_IP=
FIRESTICK_ADB_PORT=5555

# Optional machine paths. Otherwise the script uses existing environment settings.
JAVA_HOME=
ANDROID_HOME=
